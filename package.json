{
	"name": "line-mcp-server",
	"version": "0.0.0",
	"description": "Local MCP server that mirrors a personal LINE account for coding agents",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stickerdaniel/line-mcp-server.git"
	},
	"homepage": "https://github.com/stickerdaniel/line-mcp-server#readme",
	"bugs": {
		"url": "https://github.com/stickerdaniel/line-mcp-server/issues"
	},
	"type": "module",
	"bin": {
		"line-mcp": "./dist/cli.js"
	},
	"files": [
		"dist",
		"launchd",
		"THIRD_PARTY_NOTICES.md"
	],
	"os": [
		"darwin"
	],
	"packageManager": "bun@1.3.9",
	"engines": {
		"node": ">=24.18.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node scripts/build.ts",
		"prepack": "bun run build",
		"cli": "node src/cli.ts",
		"check": "tsc --noEmit",
		"lint": "oxlint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest --run --passWithNoTests",
		"verify": "bun run format:check && bun run lint && bun run check && bun run test",
		"prepare": "husky"
	},
	"devDependencies": {
		"@evex/linejs": "npm:@jsr/evex__linejs@3.5.0",
		"@evex/linejs-types": "npm:@jsr/evex__linejs-types@3.5.0",
		"@types/node": "24",
		"@types/qrcode-terminal": "0.12.2",
		"husky": "^9.1.7",
		"oxlint": "^1.87.0",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@modelcontextprotocol/node": "2.1.1",
		"@noble/ciphers": "2.4.0",
		"@prefecthq/fastmcp-ts": "1.7.3",
		"crypto-js": "4.2.0",
		"curve25519-js": "0.0.4",
		"node-bignumber": "1.2.2",
		"node-int64": "0.4.0",
		"qrcode-terminal": "0.12.0",
		"thrift": "0.20.0",
		"tweetnacl": "1.0.3",
		"undici": "7.30.0",
		"zod": "4.6.6"
	}
}
