{
	"name": "line-mcp-server",
	"version": "0.0.0",
	"private": true,
	"description": "Local MCP server that mirrors a personal LINE account for coding agents",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stickerdaniel/line-mcp-server.git"
	},
	"homepage": "https://github.com/stickerdaniel/line-mcp-server#readme",
	"bugs": {
		"url": "https://github.com/stickerdaniel/line-mcp-server/issues"
	},
	"type": "module",
	"bin": {
		"line-mcp": "./src/cli.ts"
	},
	"packageManager": "bun@1.3.9",
	"engines": {
		"node": ">=24.18.0"
	},
	"scripts": {
		"cli": "node src/cli.ts",
		"check": "tsc --noEmit",
		"lint": "oxlint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest --run --passWithNoTests",
		"verify": "bun run format:check && bun run lint && bun run check && bun run test",
		"prepare": "husky"
	},
	"devDependencies": {
		"@types/node": "24",
		"@types/qrcode-terminal": "0.12.2",
		"husky": "^9.1.7",
		"oxlint": "^1.87.0",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@evex/linejs": "npm:@jsr/evex__linejs@3.5.0",
		"@evex/linejs-types": "npm:@jsr/evex__linejs-types@3.5.0",
		"@modelcontextprotocol/node": "2.1.1",
		"@prefecthq/fastmcp-ts": "1.7.3",
		"qrcode-terminal": "0.12.0",
		"zod": "4.6.6"
	}
}
