# Template rendered by `line-mcp install`, which fills in the {{...}} values.
[Unit]
Description=line-mcp daemon

[Service]
Type=exec
WorkingDirectory=%h
ExecStart={{NODE}} {{CLI}} daemon
{{ENVIRONMENT}}
Restart=always
RestartSec=30s
UMask=0077
TimeoutStopSec=10s
StandardOutput=append:{{LOG}}
StandardError=inherit

[Install]
WantedBy=default.target
