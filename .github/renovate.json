{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:best-practices"],
	"schedule": ["before 6am on Monday"],
	"vulnerabilityAlerts": {
		"enabled": true,
		"labels": ["security"],
		"schedule": ["at any time"]
	},
	"packageRules": [
		{
			"description": "Group safe non-major updates; LINEJS talks to an unofficial protocol, so updates of @evex-dev/linejs and @evex-dev/linejs-types stay separate",
			"matchUpdateTypes": ["minor", "patch", "pin", "digest"],
			"matchPackageNames": ["!/^@evex-dev\\/linejs/"],
			"groupName": "all non-major dependencies",
			"groupSlug": "all-minor-patch"
		}
	]
}
